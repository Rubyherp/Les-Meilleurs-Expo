# ── Base CUDA image ──────────────────────────────────────────────────────────
# Verified pairing: operator must confirm the GMI GPU product / CUDA version
# match.  Do not hard-code GPU product IDs.  Bump FROM when the GMI account
# provides a newer CUDA template.
#
# Reference: https://hub.docker.com/r/nvidia/cuda
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /service

# ── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        python3 \
        python3-dev \
        python3-venv \
        ffmpeg \
        libglib2.0-0 \
        libgl1 \
        libsndfile1 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ── Python virtual environment ───────────────────────────────────────────────
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# ── Install project dependencies ─────────────────────────────────────────────
# CUDA-enabled PyTorch is pinned to a version compatible with the base image.
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128 \
    && python -c "import tomllib; data = tomllib.load(open('pyproject.toml', 'rb')); print(*data['build-system']['requires'], *data['project']['dependencies'], sep='\n')" \
    | pip install --requirement /dev/stdin

# ── Application source ───────────────────────────────────────────────────────
COPY README.md ./
COPY app ./app
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-build-isolation --no-deps .

# ── Model assets (provisioned at runtime) ────────────────────────────────────
RUN mkdir -p /service/models

# ── Smoke checks ─────────────────────────────────────────────────────────────
# Import-only checks — validate that CUDA / CuDNN / FFmpeg bindings are
# present.  CUDA device availability is verified at deployment/startup by
# deploy/gmi/smoke-test.sh; never assume GPU presence during build.
RUN python -c "import torch; print(f'PyTorch {torch.__version__} OK')" \
    && python -c "import cv2; print(f'OpenCV backend: {cv2.getBuildInformation().splitlines()[0]}')" \
    && ffmpeg -version \
    && python -c "import ultralytics; print('Ultralytics OK')"

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
