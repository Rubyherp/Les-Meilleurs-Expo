APP_NAME=Video Analysis API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/video_analysis
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=.storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-analysis
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_BYTES=524288000
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska
SAMPLE_FPS=10
FRAME_STRIDE=1
DETECTOR_CONFIDENCE=0.25
MAX_PERSONS=5
CROP_PADDING=0.15
TRACKER_NAME=bytetrack.yaml
TRACKER_BUFFER_SECONDS=2.0
# TRACKER_BUFFER_FRAMES=30
TRACKER_IOU_THRESHOLD=0.1
TRACKER_HIGH_CONFIDENCE=0.40
TRACKER_LOW_CONFIDENCE=0.1
GRID_COLUMNS=10
GRID_ROWS=10
COMPARISON_MAX_DANCERS=24
COMPARISON_MIN_COVERAGE=0.5
COMPARISON_MAX_COST=1.0
COMPARISON_UNMATCHED_PENALTY=1.25
COMPARISON_INCLUDE_PREDICTED=false
COMPARISON_PREDICTED_WEIGHT=0.1
YOLO_MODEL_PATH=models/yolo11n.pt
POSE_MODEL_PATH=models/pose_landmarker_lite.task
ML_DEVICE=cpu
ANALYSIS_CONTROL_MODE=active
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_MIN_QUALITY_SCORE=0.72
ANALYSIS_MIN_IMPROVEMENT=0.025
ANALYSIS_SCOUT_FPS=2
ANALYSIS_SCOUT_MAX_FRAMES=24
ANALYSIS_FAST_SAMPLE_FPS=5
ANALYSIS_RECOVERY_SAMPLE_FPS=15
ANALYSIS_IMAGE_SIZE=640
ANALYSIS_RECOVERY_IMAGE_SIZE=960
ANALYSIS_SEGMENT_PADDING_SECONDS=0.75
ANALYSIS_MAX_RETRY_SECONDS=30
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_AUTO_CALIBRATION_ENABLED=false
# ANALYSIS_RECOVERY_YOLO_MODEL_PATH=models/yolo11s.pt
# ANALYSIS_RECOVERY_POSE_MODEL_PATH=models/pose_landmarker_full.task
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_PRESENCE_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5
LLM_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-5.4-nano
LLM_TEMPERATURE=0.3
# ── Provider integrations ──────────────────────────────────────────────
# OpenAI (shared LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
# Agnes (visual coaching provider)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_TIMEOUT_SECONDS=45.0
AGNES_MAX_EVIDENCE_MOMENTS=3
AGNES_MAX_IMAGE_EDGE=2048
# Zo (export / sharing provider)
ZO_API_KEY=
ZO_API_URL=https://api.zo.computer
ZO_EXPORT_VISIBILITY=private
ZO_TIMEOUT_SECONDS=60.0
# GMI Cloud serverless inference
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=openai/gpt-5.4-nano
GMI_TIMEOUT_SECONDS=30.0
# Optional GMI Cloud GPU Compute deployment
GMI_ENABLED=false
GMI_REGION=
GMI_INSTANCE_LABEL=
GMI_GPU_LABEL=
